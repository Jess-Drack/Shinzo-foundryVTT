<form class="{{cssClass}}" autocomplete="off">

    <header class="sheet-header">

        <img 
            class="profile-img"
            src="{{item.img}}"
            data-edit="img"
        >

        <div class="header-fields">

            <h1 class="charname">

                <input 
                    name="name"
                    type="text"
                    value="{{item.name}}"
                    placeholder="Nom du consommable"
                >

            </h1>

        </div>

    </header>

    {{#if editable}}
    <button type="button" class="consume-item">
        <i class="fas fa-hand-holding-medical"></i>
        Utiliser
    </button>
    {{/if}}

    <nav class="sheet-tabs tabs" data-group="primary">

        <a class="item active" data-tab="description">
            Description
        </a>

        <a class="item" data-tab="details">
            Détails
        </a>

    </nav>


    <section class="sheet-body">


    <!-- DESCRIPTION -->

    <div class="tab description active" data-group="primary" data-tab="description">

        {{editor
            enrichedDescription
            target="system.description"
            button=true
            editable=editable
        }}

    </div>



    <!-- DETAILS -->

    <div class="tab details" data-group="primary" data-tab="details">


    <div class="form-group">

    <label>
    Type de consommation
    </label>

    <select name="system.consumeType">

    <option 
    value="quantity"
    {{#if (eq system.consumeType "quantity")}}selected{{/if}}>
    Quantité
    </option>

    <option 
    value="charges"
    {{#if (eq system.consumeType "charges")}}selected{{/if}}>
    Charges
    </option>

    </select>

    </div>


    <div class="form-group">

    <label>
    Quantité
    </label>

    <input 
    type="number"
    name="system.quantity"
    value="{{system.quantity}}"
    min="0"
    />

    </div>


    <div class="form-group">

    <label>
    Objet empilable
    </label>

    <input 
    type="checkbox"
    name="system.stackable"
    {{checked system.stackable}}
    />

    </div>


    <div class="form-group">

    <label>
    Maximum de la pile
    </label>

    <input 
    type="number"
    name="system.maxQuantity"
    value="{{system.maxQuantity}}"
    min="1"
    />

    </div>


    <hr>


    <div class="form-group">

    <label>
    Charges actuelles
    </label>

    <input 
    type="number"
    name="system.charges"
    value="{{system.charges}}"
    min="0"
    />

    </div>


    <div class="form-group">

    <label>
    Charges maximum
    </label>

    <input 
    type="number"
    name="system.maxCharges"
    value="{{system.maxCharges}}"
    min="1"
    />

    </div>



    <hr>



    <h3>
    Effet
    </h3>


    {{editor
        enrichedEffect
        target="system.effect"
        button=true
        editable=editable
    }}


    </div>


    </section>


</form>