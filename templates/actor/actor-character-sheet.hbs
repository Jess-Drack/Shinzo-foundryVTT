<form class="{{cssClass}} {{actor.type}}" autocomplete="off">
  {{!-- Sheet Header --}}
  <header class="sheet-header-actor">
    <div class="sheet-header">
      <div class="header-frame">
        <div class="header-frame-color" style="--triangle-color: {{system.color}}; --triangle-color-foncee: color-mix(in srgb, var(--triangle-color), black 50%);"></div>
        <div class="header-frame-diamond" style="--triangle-color: {{system.color}}; --triangle-color-foncee: color-mix(in srgb, var(--triangle-color), black 50%);"></div>
        <img class="header-frame-img" src="systems/shinzo/img/ProfilePicture/cadrepp.png" alt=""/>
        <div class="header-right">
          <div class="control-left">
            <img class="chareval-bg" src="systems/shinzo/img/ProfilePicture/cadre-evaluation.svg" alt=""/>
            <div class="evaluation">
              <label for="system.valuation.value" class="resource-label eval">Evaluation</label>
              <span class="resultStat-value">{{system.valuation.value}}</span>
            </div>
            <div class="charcolor">
              {{#if editable}}
                <input type="color" id="colorInput" name="system.color" value="{{system.color}}" title="Couleur du personnage"/>
              {{/if}}
            </div>
          </div>
          <div class="profile-img-wrapper">
            <img class="profile-img-actor" src="{{actor.img}}" {{#if editable}}data-edit="img"{{/if}} title="{{actor.name}}"/>
          </div>
        </div>
      </div>
      
      <div class="header-fields right-field">
        <div class="control-edit">
          <label id="toggle-edit" class="switch-toggle" title="Basculer le mode édition">
            <input type="checkbox" class="toggle-edit-checkbox" {{#if editable}}checked{{/if}}/>
            <div class="slider-toggle">
              <i class="fa-solid fa-pen switch-icon"></i>
            </div>
          </label>

          {{#if editable}}
          <div class="globalBM">
            <img class="chareval-bg" src="systems/shinzo/img/ProfilePicture/cadreBM.svg" alt=""/>
            <label class="calStat">Total Bonus/Malus</label> 
            <span class="resultStat">{{system.ss_stats.totalmod.value}}</span>
          </div>
          <div class="globalAttributs">
            <img class="chareval-bg" src="systems/shinzo/img/ProfilePicture/cadreTotalAttributs.svg" alt=""/>
            <label class="calStat nameAttributs">Total Attributs</label>
            <span class="resultStat">{{system.gds_statsTotal.value}}</span>
          </div>
          {{/if}}
        </div>

        <div class="charname-wrapper charname-container">
          <img class="charname-bg" src="systems/shinzo/img/ProfilePicture/characterName.svg" alt=""/>
          <input class="charname-input" name="name" type="text" value="{{actor.name}}" placeholder="Name" style="font-size: max(14px, calc(32px - (0.6px * {{stringLength actor.name}}))) !important;" {{#unless editable}}disabled{{/unless}}/>
        </div> 

        <div class="charressources-wrapper">
          <img class="charressource-bg" src="systems/shinzo/img/ProfilePicture/cadre-ressources.svg" alt=""/>
          <div class="resources grid grid-2col">

            {{!-- BLOC POINTS DE VIE --}}
            <div class="healthpower">
              <div class="resource flex-group-center health">
                <div class="resource-content flexrow flex-center flex-between">
                  <input class="inputhealthpower" type="text" name="system.health.value" value="{{system.health.value}}" data-dtype="Number"/>
                </div>
              </div>

              <div class="abilities flexcol rdpm">
                {{#each system.derived.rdp as |rd key|}}
                <div class="abilityCbt flexrow flex-group-center">
                  <label for="system.rdp.{{key}}.value" class="resource-label flexlarge align-left {{key}}icon" title="{{localize (concat 'SHINZO.Resist.' key)}}"></label>
                  <span data-dtype="Number">{{rd.value}}</span>
                </div>
                {{/each}}
              </div>
            </div>

            {{!-- BLOC POINTS D'ÉNERGIE --}}
            <div class="healthpower">
              <div class="resource flex-group-center power">
                <div class="resource-content flexrow flex-center flex-between hpvalue">
                  <input class="inputhealthpower" type="text" name="system.power.value" value="{{system.power.value}}" data-dtype="Number"/>
                </div>
              </div>

              <div class="abilities flexcol rdpm">
                {{#each system.derived.rdm as |rd key|}}
                <div class="abilityCbt flexrow flex-group-center">
                  <label for="system.rdm.{{key}}.value" class="resource-label flexlarge align-left {{key}}icon" title="{{localize (concat 'SHINZO.Resist.' key)}}"></label>
                  <span data-dtype="Number">{{rd.value}}</span>
                </div>
                {{/each}}
              </div>
            </div>

            {{#if editable}}
            <button type="button" class="config-resources-btn" data-action="configResources" title="Configurer les caractéristiques vitales">
              <i class="margIcon fa-solid fa-gear"></i>
            </button>
            {{/if}}

          </div>
        </div>
      </div>
    </div>

    {{!-- Sheet Tab Navigation --}}
    <nav class="sheet-tabs tabs tabCharacter" data-group="primary">
      <a class="item tabItem" data-tab="stat">Statistiques</a>
      <a class="item tabItem" data-tab="description">Description</a>
      <a class="item tabItem" data-tab="spells">Capacités</a>
      <a class="item tabItem" data-tab="items">Bagages</a>
      <a class="item tabItem" data-tab="effects">Effets</a>
    </nav>
  </header>

  {{!-- Sheet Body --}}
  <section class="sheet-body bodyCharacter">

    <div class="tab features" data-group="primary" data-tab="stat">
      {{> "systems/shinzo/templates/actor/parts/actor-stats.hbs"}}
      </br>
      <h4 class="titleActorPages">Notes</h4>
      {{editor enrichedNote target="system.note" engine="prosemirror" button=true editable=editable}}
    </div>

    {{!-- Biography Tab --}}
    <div class="tab biography" data-group="primary" data-tab="description">
      {{!-- Editors must receive enriched text data from getData to properly handle rolls --}}
      {{> "systems/shinzo/templates/actor/parts/actor-description.hbs"}}
      <h4 class="titleActorPages">Histoire</h4>
      {{editor enrichedBiography target="system.biography" engine="prosemirror" button=true editable=editable}}
    </div>

    {{!-- Owned Items Tab --}}
    <div class="tab items" data-group="primary" data-tab="items">
       {{> "systems/shinzo/templates/actor/parts/actor-items.hbs"}}
    </div>

    {{!-- Owned Spells Tab & Owned Features Tab --}}
    <div class="tab spells" data-group="primary" data-tab="spells">
      {{#if editable}}
      <a class='item-control item-create' title='{{localize 'DOCUMENT.New' type='trait'}}' data-type='trait'>
        <div class="add">
          <i class="fa-solid fa-plus"></i>
        </div>
      </a>
      {{/if}}
      <h4 class="titleActorPages">Traits</h4>
      {{> "systems/shinzo/templates/actor/parts/actor-traits.hbs"}}
      {{#if editable}}
      <a class='item-control item-create' title='{{localize 'DOCUMENT.New' type='competence'}}' data-type='competence'>
        <div class="add">
          <i class="fa-solid fa-plus"></i>
        </div>
      </a>
      {{/if}}
      <h4 class="titleActorPages">Compétences</h4>
      {{> "systems/shinzo/templates/actor/parts/actor-competences.hbs"}}
    </div>

    {{!-- Active Effects Tab --}}
    <div class="tab effects flexcol" data-group="primary" data-tab="effects">
      {{> "systems/shinzo/templates/actor/parts/actor-effects.hbs"}}
    </div>

  </section>
</form>
