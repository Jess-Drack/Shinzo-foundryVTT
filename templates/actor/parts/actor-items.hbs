<div class="addBagage" data-type="arme">
    <i class="fa-solid fa-plus"></i>
</div>
{{!-- SECTION 1 : ARMES ÉQUIPÉES --}}
{{#if hasEquippedWeapons}}
<ol class='items-list'>
  <h2 class="titleActorPages">Armes</h2>

  <details data-section="arme" {{#if sectionsOpen.arme}}open{{/if}}>
    <summary class="inventory-summary-header">
      <li class='item flexrow items-header'>
        <div class='item-name'>
          {{localize 'Name'}}
        </div>
        <div class='item-degat'>Dégâts</div>
        <div class='item-controls'>
          <i class="fa-solid fa-chevron-right folder-icon"></i>
        </div>
      </li>
    </summary>

    <div class="folder-content">
      {{#each arme as |item id|}}
        {{#if item.system.equipped }}
          <li class='item flexrow' data-item-id='{{item._id}}' draggable="true">
            <div class='item-name'>
              <div class='item-image'>
                <a class='rollable' data-roll-type='item'>
                  <img src='{{item.img}}' title='{{item.name}}' width='24' height='24' class="item-image-content"/>
                </a>
              </div>
              <a class='item-control item-edit itemAnimation' title='{{localize "DOCUMENT.Update" type='Item'}}'>
                <p>{{item.name}}</p>
              </a>
            </div>
            <a class='deArme' data-formule='{{item.system.damage}}' data-nom='{{item.name}}'>
              <div class='item-formula item-prop itemAnimation'>{{item.system.damage}}</div>
            </a>
            <div class='item-controls'>
              <div class='item-equipped'>
                <input type="checkbox" name="system.equipped" title="Équipé" class="equipped-toggle equipped-style itemAnimation" {{checked item.system.equipped}}/>
              </div>
              {{#if ../editable}}
                <a class='item-control item-edit itemAnimation' title='{{localize "DOCUMENT.Update" type='Item'}}'><i class="fas fa-edit"></i></a>
                <a class='item-control item-delete itemAnimation' title='{{localize "DOCUMENT.Delete" type='Item'}}'><i class='fas fa-trash'></i></a>
              {{/if}}
            </div>
          </li>
        {{/if}}
      {{/each}}
    </div>
  </details>
</ol>
{{/if}}


{{!-- SECTION 2 : ARMURES / SACS ÉQUIPÉS --}}
{{#if hasEquippedProtection}}
<ol class='items-list'>
  <h2 class="titleActorPages">Armure / Tenue</h2>
  
  <details data-section="armure" {{#if sectionsOpen.armure}}open{{/if}}>
    <summary class="inventory-summary-header">
      <li class='item flexrow items-header'>
        <div class='item-name'>
          {{localize 'Name'}}
        </div>
        <div class='item-res'>Résistance physique</div>
        <div class='item-res'>Résistance magique</div>
        <div class='item-controls'>
          <i class="fa-solid fa-chevron-right folder-icon"></i>
        </div>
      </li>
    </summary>

    <div class="folder-content">
      {{#each armure as |item id|}}
        {{#if item.system.equipped }}
          <li class='item flexrow' data-item-id='{{item._id}}' draggable="true">
            <div class='item-name'>
              <div class='item-image'>
                <a class='rollable' data-roll-type='item'>
                  <img src='{{item.img}}' title='{{item.name}}' width='24' height='24' class="item-image-content"/>
                </a>
              </div>
              <a class='item-control item-edit itemAnimation' title='{{localize "DOCUMENT.Update" type='Item'}}'>
                <p>{{item.name}}</p>
              </a>
            </div>
            <div class='item-res item-prop'>{{item.system.resPhysique}}</div>
            <div class='item-res item-prop'>{{item.system.resMagique}}</div>
            <div class='item-controls'>
              <div class='item-equipped'>
                <input type="checkbox" name="system.equipped" title="Équipé" class="equipped-toggle equipped-style itemAnimation" {{checked item.system.equipped}}/>
              </div>
              {{#if ../editable}}
                <a class='item-control item-edit itemAnimation' title='{{localize "DOCUMENT.Update" type='Item'}}'><i class="fas fa-edit"></i></a>
                <a class='item-control item-delete itemAnimation' title='{{localize "DOCUMENT.Delete" type='Item'}}'><i class='fas fa-trash'></i></a>
              {{/if}}
            </div>
          </li>
        {{/if}}
      {{/each}}
      {{#each sac as |item id|}}
        {{#if item.system.equipped }}
          <li class='item flexrow' data-item-id='{{item._id}}' draggable="true">
            <div class='item-name'>
              <div class='item-image'>
                <a class='rollable' data-roll-type='item'>
                  <img src='{{item.img}}' title='{{item.name}}' width='24' height='24' class="item-image-content"/>
                </a>
              </div>
              <a class='item-control item-edit itemAnimation' title='{{localize "DOCUMENT.Update" type='Item'}}'>
                <p>{{item.name}}</p>
              </a>
            </div>
            <div class='item-controls'>
              <div class='item-equipped'>
                <input type="checkbox" name="system.equipped" title="Équipé" class="equipped-toggle equipped-style itemAnimation" {{checked item.system.equipped}}/>
              </div>
              {{#if ../editable}}
                <a class='item-control item-edit itemAnimation' title='{{localize "DOCUMENT.Update" type='Item'}}'><i class="fas fa-edit"></i></a>
                <a class='item-control item-delete itemAnimation' title='{{localize "DOCUMENT.Delete" type='Item'}}'><i class='fas fa-trash'></i></a>
              {{/if}}
            </div>
          </li>
        {{/if}}
      {{/each}}
    </div>
  </details>
</ol>
{{/if}}


{{!-- SECTION 3 : CONSOMMABLES --}}
{{#if consommable.length}}
<ol class="items-list">
  <h2 class="titleActorPages">Consommables</h2>
  
  <details data-section="consommable" {{#if sectionsOpen.consommable}}open{{/if}}>
    <summary class="inventory-summary-header">
      <li class='item flexrow items-header'>
        <div class='item-name'>
          {{localize 'Name'}}
        </div>
        <div class='item-res'>Quantité</div>
        <div class='item-controls'>
          <i class="fa-solid fa-chevron-right folder-icon"></i>
        </div>
      </li>
    </summary>

    <div class="folder-content">
      {{#each consommable as |item id|}}
      <li class="item flexrow" data-item-id="{{item._id}}" draggable="true">
        <div class='item-name'>
          <div class='item-image'>
            <a class='rollable' data-roll-type='item'>
              <img src="{{item.img}}" title='{{item.name}}' width="24" height="24" class="item-image-content">
            </a>
          </div>
          <a class='item-control item-edit itemAnimation' title='{{localize "DOCUMENT.Update" type='Item'}}'>
            <p>{{item.name}}</p>
          </a>
        </div>
        <div class='item-res item-prop'>{{item.system.quantity}}</div>
        <div class="item-controls">
          {{#if (eq item.system.consumeType "charges")}}
            <span>{{item.system.charges}} / {{item.system.maxCharges}}</span>
          {{else}}
            <span>x{{item.system.quantity}}</span>
          {{/if}}
          <a class="item-consume itemAnimation"><i class="fas fa-flask"></i></a>
          {{#if ../editable}}
            <a class="item-edit itemAnimation"><i class="fas fa-edit"></i></a>
            <a class="item-delete itemAnimation"><i class="fas fa-trash"></i></a>
          {{/if}}
        </div>
      </li>
      {{/each}}
    </div>
  </details>
</ol>
{{/if}}


{{!-- SECTION 4 : BAGAGES ET DEVISES --}}
<div class="items-and-money">
  
  {{#if hasBagages}}
  <ol class='items-list bagageList'>
    <h2 class="titleActorPages">Bagages</h2>
    
    <details data-section="bagage" {{#if sectionsOpen.bagage}}open{{/if}}>
      {{!-- Le summary enveloppe désormais directement la ligne d'en-tête --}}
      <summary class="inventory-summary-header">
        <li class='item flexrow items-header'>
          <div class='item-name'>
            {{localize 'Name'}}
          </div>
          <div class='item-controls'>
            <i class="fa-solid fa-chevron-right folder-icon"></i>
          </div>
        </li>
      </summary>

      {{!-- Le contenu plié ne contient plus que les lignes d'objets --}}
      <div class="folder-content">
        {{!-- Objets génériques --}}
        {{#each objet as |item id|}}
          <li class='item flexrow' data-item-id='{{item._id}}' draggable="true">
            <div class='item-name'>
              <div class='item-image'>
                <a class='rollable' data-roll-type='item'>
                  <img src='{{item.img}}' title='{{item.name}}' width='24' height='24' class="item-image-content"/>
                </a>
              </div>
              <a class='item-control item-edit itemAnimation' title='{{localize "DOCUMENT.Update" type='Item'}}'>
                <p>{{item.name}}</p>
              </a>
            </div>
            {{#if ../editable}}
              <div class='item-controls'>
                <a class='item-control item-edit itemAnimation' title='{{localize "DOCUMENT.Update" type='Item'}}'><i class="fas fa-edit"></i></a>
                <a class='item-control item-delete itemAnimation' title='{{localize "DOCUMENT.Delete" type='Item'}}'><i class='fas fa-trash'></i></a>
              </div>
            {{/if}}
          </li>
        {{/each}}
        
        {{!-- Armes non équipées --}}
        {{#each arme as |item id|}}
          {{#unless item.system.equipped }}
            <li class='item flexrow' data-item-id='{{item._id}}' draggable="true">
              <div class='item-name'>
                <div class='item-image'>
                  <a class='rollable' data-roll-type='item'>
                    <img src='{{item.img}}' title='{{item.name}}' width='24' height='24' class="item-image-content"/>
                  </a>
                </div>
                <a class='item-control item-edit itemAnimation' title='{{localize "DOCUMENT.Update" type='Item'}}'>
                  <p>{{item.name}}</p>
                </a>
              </div>
              <div class='item-controls'>
                <div class='item-equipped'>
                  <input type="checkbox" name="system.equipped" title="Équipé" class="equipped-toggle equipped-style itemAnimation" {{checked item.system.equipped}}/>
                </div>
                {{#if ../editable}}
                  <a class='item-control item-edit itemAnimation' title='{{localize "DOCUMENT.Update" type='Item'}}'><i class="fas fa-edit"></i></a>
                  <a class='item-control item-delete itemAnimation' title='{{localize "DOCUMENT.Delete" type='Item'}}'><i class='fas fa-trash'></i></a>
                {{/if}}
              </div>
            </li>
          {{/unless}}
        {{/each}}
        
        {{!-- Armures non équipées --}}
        {{#each armure as |item id|}}
          {{#unless item.system.equipped }}
            <li class='item flexrow' data-item-id='{{item._id}}' draggable="true">
              <div class='item-name'>
                <div class='item-image'>
                  <a class='rollable' data-roll-type='item'>
                    <img src='{{item.img}}' title='{{item.name}}' width='24' height='24' class="item-image-content"/>
                  </a>
                </div>
                <a class='item-control item-edit itemAnimation' title='{{localize "DOCUMENT.Update" type='Item'}}'>
                  <p>{{item.name}}</p>
                </a>
              </div>
              <div class='item-controls'>
                <div class='item-equipped'>
                  <input type="checkbox" name="system.equipped" title="Équipé" class="equipped-toggle equipped-style itemAnimation" {{checked item.system.equipped}}/>
                </div>
                {{#if ../editable}}
                  <a class='item-control item-edit itemAnimation' title='{{localize "DOCUMENT.Update" type='Item'}}'><i class="fas fa-edit"></i></a>
                  <a class='item-control item-delete itemAnimation' title='{{localize "DOCUMENT.Delete" type='Item'}}'><i class='fas fa-trash'></i></a>
                {{/if}}
              </div>
            </li>
          {{/unless}}
        {{/each}}
        
        {{!-- Sacs non équipés --}}
        {{#each sac as |item id|}}
          {{#unless item.system.equipped }}
            <li class='item flexrow' data-item-id='{{item._id}}' draggable="true">
              <div class='item-name'>
                <div class='item-image'>
                  <a class='rollable' data-roll-type='item'>
                    <img src='{{item.img}}' title='{{item.name}}' width='24' height='24' class="item-image-content"/>
                  </a>
                </div>
                <a class='item-control item-edit itemAnimation' title='{{localize "DOCUMENT.Update" type='Item'}}'>
                  <p>{{item.name}}</p>
                </a>
              </div>
              <div class='item-controls'>
                <div class='item-equipped'>
                  <input type="checkbox" name="system.equipped" title="Équipé" class="equipped-toggle equipped-style itemAnimation" {{checked item.system.equipped}}/>
                </div>
                {{#if ../editable}}
                  <a class='item-control item-edit itemAnimation' title='{{localize "DOCUMENT.Update" type='Item'}}'><i class="fas fa-edit"></i></a>
                  <a class='item-control item-delete itemAnimation' title='{{localize "DOCUMENT.Delete" type='Item'}}'><i class='fas fa-trash'></i></a>
                {{/if}}
              </div>
            </li>
          {{/unless}}
        {{/each}}
      </div>
    </details>
  </ol>
  {{/if}}

  {{!-- BLOC DEVISES --}}
  <div class="abilities flexcol devises">
    <h2 class="titleActorPages">Devises</h2>
    {{#each system.devise as |devise key|}}
      {{#if (or (eq key "or") (eq key "argent") (eq key "cuivre"))}}
        <div class="ability flexrow flex-group-center">
          <label for="system.devise.{{key}}.value" class="resource-label flexlarge align-left">{{key}}</label>
          <input type="text" name="system.devise.{{key}}.value" value="{{devise.value}}" data-dtype="Number" {{#unless ../editable}}disabled{{/unless}}/>
        </div>
      {{/if}}
    {{/each}}
  </div>
</div>
