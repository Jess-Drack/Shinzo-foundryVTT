<aside class="sidebar">
    {{!-- Grandes Statistiques --}}
    <div class="abilities gdsStatsGroup">
        {{#each system.gds_stats as |gd_stat key|}}
            <div class="ability flex-group-center gdsStatsGroupInput">
              <div class="nameStats">
                <label for="system.gds_stats.{{key}}.value" 
                class="resource-label rollable deStat flexlarge align-left {{#if gd_stat.addCrit }}underline{{/if}}" {{#if gd_stat.addCrit }}
                title="Bonus/malus au critique : {{gd_stat.addCrit}}"{{/if}} 
                data-dice="{{gd_stat.displayValue}}"  data-statName="{{key}}" 
                data-crit="{{gd_stat.addCrit}}" 
                data-label="{{localize (lookup @root.config.caracteristiques key)}}" >{{localize (lookup @root.config.caracteristiques key)}}
                </label>
              </div>
              <div class="nbStatsGds">
                {{#if ../editable}}
                <input class="inputGDstats" type="text" name="system.gds_stats.{{key}}.value" value="{{gd_stat.value}}" data-dtype="Number"/>
                {{else}}
                <span class="ability-mod rollable deStat" data-dice="{{gd_stat.displayValue}}" data-statName="{{key}}" data-label="{{localize (lookup @root.config.caracteristiques key)}}">{{gd_stat.displayValue}}</span>
                {{/if}}
              </div>
              {{#if ../editable}}
              <div class="checkspe">
                <input type="checkbox" name="system.gds_stats.{{key}}.spe_check" {{#if gd_stat.spe_check}}checked{{/if}} class="specialization-toggle radio-style"/>
              </div>
              {{/if}}
              {{#if gd_stat.spe_check }}
              {{#if (not ../editable) }}
                <button type="button" 
                        class="spe-toggle-btn" 
                        data-action="toggleSpe" 
                        data-target="system.gds_stats.{{key}}.spe" 
                        data-label="{{localize (lookup @root.config.caracteristiques key)}}"
                        title="Lancer le jet de Spécialisation">
                  <i class="margIcon fa-solid fa-star"></i>
                </button>
              {{/if}}
              {{/if}}
            </div>
        {{/each}}
    </div>

    {{!-- Maîtrises intermédiaires --}}
    <section class="tabmaitrise">
        <div class="abilities gdsStatsGroup maitrise">
          {{#each system.maitrises as |maitrise key|}}
          <div class="ability flex-group-center maitriseGroupInput">
            <label for="system.maitrises.{{key}}.value" class="resource-label align-left" data-label="{{localize (lookup @root.config.caracteristiques key)}}">{{localize (lookup @root.config.caracteristiques key)}}</label>
            <div class="nbStats">
            <span class="ability-mod" data-label="{{localize (lookup @root.config.caracteristiques key)}}">{{maitrise.value}}</span>
            </div>
          </div>
          {{/each}}
        </div>
    </section>

    {{!-- Sous-Statistiques (Groupe 1 et Groupe 2) --}}
    <section class="grid grid-2col">
        {{!-- GROUPE 1 --}}
        <div class="abilities flexcol ss_statsFond">
          {{#each system.ss_stats.ss_stats1 as |ss_stat key|}}
          <div class="ability flexrow flex-group-center">
            <div class="ss_statsGroup">
              <label for="system.ss_stats.ss_stats1.{{key}}.value" class="resource-label rollable deStat flexlarge align-left {{#if ss_stat.addCrit }}underline{{/if}}" {{#if ss_stat.addCrit }}title="Bonus/malus au critique : {{ss_stat.addCrit}}"{{/if}} data-dice="{{ss_stat.displayValue}}"  data-crit="{{ss_stat.addCrit}}" data-statName="{{key}}" data-label="{{localize (lookup @root.config.caracteristiques key)}}">{{localize (lookup @root.config.caracteristiques key)}}</label>
            </div>
            {{#if ../editable}}
              <input type="text" name="system.ss_stats.ss_stats1.{{key}}.mod" value="{{ss_stat.mod}}" data-dtype="Number"/>
            {{/if}}
            <span class="ability-mod rollable deStat {{#if (not ../editable) }}value-non-editable{{/if}}" data-dice="{{ss_stat.displayValue}}" data-statName="{{key}}" data-label="{{localize (lookup @root.config.caracteristiques key)}}">{{ss_stat.displayValue}}</span>
            {{#if ../editable}}
            <div class="checkspe">
              <input type="checkbox" name="system.ss_stats.ss_stats1.{{key}}.spe_check" {{#if ss_stat.spe_check}}checked{{/if}} class="specialization-toggle radio-style"/>
            </div>
            {{/if}}
          {{#if (not ../editable) }}
          <div class="checkspe">
            {{#if ss_stat.spe_check}}
              <button type="button" 
                      class="spe-toggle-btn" 
                      data-action="toggleSpe" 
                      data-target="system.ss_stats.ss_stats1.{{key}}.spe"
                      data-label="{{localize (lookup @root.config.caracteristiques key)}}"
                      title="Lancer le jet de Spécialisation">
                <i class="margIcon fa-solid fa-star"></i>
              </button>
            {{/if}}
          </div>
          {{/if}}
          </div>
          {{/each}}
        </div>

        {{!-- GROUPE 2 --}}
        <div class="abilities flexcol ss_statsFond">
          {{#each system.ss_stats.ss_stats2 as |ss_stat key|}}
          <div class="ability flexrow flex-group-center">
            <div class="ss_statsGroup">
              <label for="system.ss_stats.ss_stats2.{{key}}.value" class="resource-label rollable deStat flexlarge align-left {{#if ss_stat.addCrit }}underline{{/if}}" {{#if ss_stat.addCrit }}title="Bonus/malus au critique : {{ss_stat.addCrit}}"{{/if}} data-dice="{{ss_stat.displayValue}}"  data-crit="{{ss_stat.addCrit}}" data-statName="{{key}}" data-label="{{localize (lookup @root.config.caracteristiques key)}}">{{localize (lookup @root.config.caracteristiques key)}}</label>
            </div>
            {{#if ../editable}}
              <input type="text" name="system.ss_stats.ss_stats2.{{key}}.mod" value="{{ss_stat.mod}}" data-dtype="Number"/>
            {{/if}}
            <span class="ability-mod rollable deStat {{#if (not ../editable) }}value-non-editable{{/if}}" data-dice="{{ss_stat.displayValue}}" data-statName="{{key}}" data-label="{{localize (lookup @root.config.caracteristiques key)}}">{{ss_stat.displayValue}}</span>
              {{#if ../editable}}
              <div class="checkspe">
                <input type="checkbox" name="system.ss_stats.ss_stats2.{{key}}.spe_check" {{#if ss_stat.spe_check}}checked{{/if}} class="specialization-toggle radio-style"/>
              </div>
              {{/if}}
            {{#if (not ../editable) }}
            <div class="checkspe">
              {{#if ss_stat.spe_check}}
                <button type="button" 
                        class="spe-toggle-btn" 
                        data-action="toggleSpe" 
                        data-target="system.ss_stats.ss_stats2.{{key}}.spe"
                        data-label="{{localize (lookup @root.config.caracteristiques key)}}"
                        title="Lancer le jet de Spécialisation">
                  <i class="margIcon fa-solid fa-star"></i>
                </button>
              {{/if}}
            </div>
            {{/if}}
          </div>
          {{/each}}
        </div>
    </section>
</aside>
