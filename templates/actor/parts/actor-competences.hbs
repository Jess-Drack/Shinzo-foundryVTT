<ol class='items-list'>
  <details data-section="competences" {{#if sectionsOpen.competences}}open{{/if}}>
    <summary class="inventory-summary-header">
      <li class='item flexrow items-header'>
        <div class='item-name'>{{localize 'Name'}}</div>
        <div class='item-cost'>Coûts</div>
        <div class='item-controls'>
          <i class="fa-solid fa-chevron-right folder-icon"></i>
        </div>
      </li>
    </summary>
    <div class="folder-content">
    {{#each competence as |item id|}}
      <li class='item flexrow' data-item-id='{{item._id}}' draggable="true">
        <div class='item-name'>
          <div class='item-image'>
            <a class='rollable' data-roll-type='item'>
              <img
                src='{{item.img}}'
                title='{{item.name}}'
                width='24'
                height='24'
                class="item-image-content"
              />
            </a>
          </div>
          <a class='item-control item-edit' title='{{localize "DOCUMENT.Update" type='Item'}}'>
            <p>{{item.name}}</p>
          </a>
        </div>
        <div class='item-cost item-prop'>{{item.system.cost}}{{item.system.unit}}{{item.system.turn}}</div>
        {{#if ../editable }}
        <div class='item-controls'>
          <a class='item-control item-edit' title='{{localize "DOCUMENT.Update" type='Item'}}'>
            <i class="fas fa-edit"></i>
          </a>
          <a class='item-control item-delete' title='{{localize "DOCUMENT.Delete" type='Item'}}'>
            <i class='fas fa-trash'></i>
          </a>
        </div>
        {{/if}}
      </li>
    {{/each}}
    </div>
  </details>
</ol>